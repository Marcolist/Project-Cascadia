--- a/drivers/usb/dwc2/p105-udc-observer.c
+++ b/drivers/usb/dwc2/p105-udc-observer.c
@@ -116,3 +116,14 @@
 	*out = o->seen;
 	spin_unlock_irqrestore(&o->lock, flags);
 }
+
+bool p105_udc_observer_try_read(struct p105_udc_observer *o,
+				struct p105_udc_observation *out)
+{
+	unsigned long flags;
+	if (!spin_trylock_irqsave(&o->lock, flags))
+		return false;
+	*out = o->seen;
+	spin_unlock_irqrestore(&o->lock, flags);
+	return true;
+}
