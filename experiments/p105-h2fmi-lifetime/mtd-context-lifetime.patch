@@ -655,6 +671,13 @@
 	if (WARN_ONCE(mtd->dev.type, "MTD already registered\n"))
 		return -EEXIST;
 
+	/* This opt-in currently supports built-in providers only: an external
+	 * struct device reference does not pin a loadable driver module. */
+	if (master->retain_device_context &&
+	    (!IS_BUILTIN(CONFIG_MTD) || master->owner ||
+	     !master->_get_device || !master->_put_device))
+		return -EINVAL;
