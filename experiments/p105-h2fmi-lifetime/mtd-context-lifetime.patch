 static void mtd_release(struct device *dev)
 {
 	struct mtd_info *mtd = dev_get_drvdata(dev);
+	struct mtd_info *master = NULL;
+	void (*put_driver)(struct mtd_info *) = NULL;
 	dev_t index = MTD_DEVT(mtd->index);
+
+	if (mtd->driver_device_ref) {
+		master = mtd_get_master(mtd);
+		mtd->driver_device_ref = false;
+		put_driver = master->_put_device;
+	}
 
 	idr_remove(&mtd_idr, mtd->index);
 	of_node_put(mtd_get_of_node(mtd));
@@ -102,12 +110,17 @@
 
 	/* remove /dev/mtdXro node */
 	device_destroy(&mtd_class, index + 1);
+
+	/* Last: this may free the driver-owned master/context. */
+	if (put_driver)
+		put_driver(master);
 }
 
 static void mtd_device_release(struct kref *kref)
 {
 	struct mtd_info *mtd = container_of(kref, struct mtd_info, refcnt);
 	bool is_partition = mtd_is_partition(mtd);
+	bool driver_device_ref = mtd->driver_device_ref;
 
